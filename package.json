    "test": "pnpm -r run test",
    "posttest": "pnpm lint",
    "ship": "pnpm --filter gscan run ship",
    "ship:ci": "pnpm --filter gscan run ship:ci"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
