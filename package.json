    "eslint": "10.12.0",
    "eslint-plugin-ghost": "3.5.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.1+sha512.5b0e3288239a7ea4155d2094f547066e122a1376b3cd785a680c9112e116913e64aaaecf20dd83cc34030fa67013f5c5511f9cf430dd8384188b4c60b8a2ad1e"
