{
  "name": "gscan-root",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for GScan: the gscan library/CLI and its web frontend",
  "repository": {
    "type": "git",
    "url": "git@github.com:TryGhost/gscan.git"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "bugs": {
    "url": "https://github.com/TryGhost/gscan/issues"
  },
  "author": {
    "name": "Ghost Foundation",
    "email": "hello@ghost.org",
    "web": "https://ghost.org/"
  },
  "license": "MIT",
  "scripts": {
    "start": "pnpm --filter @tryghost/gscan-web run start",
    "dev": "pnpm --filter @tryghost/gscan-web run dev",
    "lint": "eslint . --cache",
    "test": "pnpm -r run test",
    "posttest": "pnpm lint",
    "ship": "pnpm --filter gscan run ship",
    "ship:ci": "pnpm --filter gscan run ship:ci"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
