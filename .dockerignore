# Ignore installed dependencies — the image installs its own
**/node_modules/

# Ignore config. These patterns are not recursive by default, so they are
# anchored with **/ to also cover apps/web, where the app's config now lives.
**/config.*.json
!**/config.example.json

# Ignore local environment files
**/.env
**/.env.local

# Ignore version control and CI/CD configuration
.git/
.gitignore
.dockerignore
.github/

# Ignore IDE specific files
.vscode/

# Ignore artefacts and sources the web app image does not need
**/coverage/
packages/gscan/test/
k8s/
